{
  "info": {
    "_postman_id": "product-service-collection",
    "name": "Product Service",
    "description": "Colección completa de pruebas para el Product Service - Incluye Productos, Lotes y Planes de Venta",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Productos (Legacy)",
      "item": [
        {
          "name": "Listar Productos (Legacy)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer YOUR_JWT_TOKEN"
              },
              {
                "key": "X-User-Roles",
                "value": "Administrador de Compras"
              }
            ],
            "url": {
              "raw": "http://localhost:8005/productos?q=ibuprofeno&categoriaId=some-uuid&sort=nombre&order=asc&page=1&page_size=25",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8005",
              "path": [
                "productos"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "ibuprofeno",
                  "description": "Búsqueda por nombre o código de barras"
                },
                {
                  "key": "categoriaId",
                  "value": "some-uuid",
                  "description": "Filtro por categoría"
                },
                {
                  "key": "sort",
                  "value": "nombre",
                  "description": "Campo de ordenamiento"
                },
                {
                  "key": "order",
                  "value": "asc",
                  "description": "Dirección: asc o desc"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Número de página"
                },
                {
                  "key": "page_size",
                  "value": "25",
                  "description": "Tamaño de página (máx 100)"
                }
              ]
            },
            "description": "Lista productos con autenticación y rol Administrador de Compras (endpoint legacy)"
          }
        },
        {
          "name": "Crear Producto (Legacy)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer YOUR_JWT_TOKEN"
              },
              {
                "key": "X-User-Roles",
                "value": "Administrador de Compras"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Idempotency-Key",
                "value": "unique-key-for-request-{{$timestamp}}",
                "description": "Clave de idempotencia para evitar duplicados"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ibuprofeno 400mg\",\n  \"descripcion\": \"Analgésico y antiinflamatorio\",\n  \"categoriaId\": \"a1b2c3d4-e5f6-7890-1234-567890abcdef\",\n  \"subcategoria\": \"Analgésicos\",\n  \"laboratorio\": \"Laboratorio XYZ\",\n  \"principioActivo\": \"Ibuprofeno\",\n  \"concentracion\": \"400mg\",\n  \"formaFarmaceutica\": \"Tableta\",\n  \"registroSanitario\": \"RS-12345\",\n  \"requierePrescripcion\": false,\n  \"codigoBarras\": \"1234567890123\",\n  \"sku\": \"IBU-400-001\",\n  \"location\": \"Estante A-12\",\n  \"ubicacion\": \"Bodega Principal\",\n  \"stock\": \"100\",\n  \"precio\": 15.50,\n  \"fechaVencimiento\": \"2025-12-31\"\n}"
            },
            "url": {
              "raw": "http://localhost:8005/productos",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8005",
              "path": [
                "productos"
              ]
            },
            "description": "Crea un nuevo producto. Requiere rol Administrador de Compras y header X-Idempotency-Key"
          }
        }
      ],
      "description": "Endpoints legacy de productos (sin prefijo /api/v1)"
    },
    {
      "name": "Productos (v1)",
      "item": [
        {
          "name": "Listar Productos (v1)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer YOUR_JWT_TOKEN"
              }
            ],
            "url": {
              "raw": "http://localhost:8005/api/v1/productos?q=aspirina&sku=12345&categoriaId=some-uuid&estado_producto=activo&sort=nombre&order=desc&page=1&page_size=25",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8005",
              "path": [
                "api",
                "v1",
                "productos"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "aspirina",
                  "description": "Búsqueda por nombre o código de barras"
                },
                {
                  "key": "sku",
                  "value": "12345",
                  "description": "Búsqueda específica por SKU"
                },
                {
                  "key": "categoriaId",
                  "value": "some-uuid",
                  "description": "Filtro por categoría (UUID válido)"
                },
                {
                  "key": "estado_producto",
                  "value": "activo",
                  "description": "Filtro por estado: activo o inactivo"
                },
                {
                  "key": "sort",
                  "value": "nombre",
                  "description": "Campo de ordenamiento"
                },
                {
                  "key": "order",
                  "value": "desc",
                  "description": "Dirección: asc o desc"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Número de página"
                },
                {
                  "key": "page_size",
                  "value": "25",
                  "description": "Tamaño de página (máx 100)"
                }
              ]
            },
            "description": "Lista productos con filtros avanzados. Requiere rol Administrador de Compras"
          }
        },
        {
          "name": "Obtener Producto por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8005/api/v1/productos/{{producto_id}}",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8005",
              "path": [
                "api",
                "v1",
                "productos",
                "{{producto_id}}"
              ]
            },
            "description": "Obtiene un producto individual por su ID con toda su información. Endpoint público."
          }
        },
        {
          "name": "Obtener Inventario de Producto",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8005/api/productos/{{producto_id}}/inventario",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8005",
              "path": [
                "api",
                "productos",
                "{{producto_id}}",
                "inventario"
              ]
            },
            "description": "Obtiene el inventario en tiempo real de un producto (cantidad disponible, precio y fecha de vencimiento). Endpoint público."
          }
        },
        {
          "name": "Actualizar Stock de Producto",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer YOUR_JWT_TOKEN"
              }
            ],
            "url": {
              "raw": "http://localhost:8005/api/v1/productos/{{producto_id}}/stock?cantidad_a_restar=10",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8005",
              "path": [
                "api",
                "v1",
                "productos",
                "{{producto_id}}",
                "stock"
              ],
              "query": [
                {
                  "key": "cantidad_a_restar",
                  "value": "10",
                  "description": "Cantidad a restar del stock (mínimo 1)",
                  "required": true
                }
              ]
            },
            "description": "Actualiza el stock de un producto restando la cantidad especificada. Usado internamente por pedidos-service. Requiere rol Administrador de Compras."
          }
        }
      ],
      "description": "Endpoints v1 de productos con prefijo /api/v1"
    },
    {
      "name": "Lotes",
      "item": [
        {
          "name": "Listar Lotes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8005/api/v1/lotes?page=1&page_size=25&sort=fechaVencimiento&order=asc&producto_id=some-product-id&categoria_id=some-category-id&bodega_id=some-warehouse-id&fecha_desde=2024-01-01&fecha_hasta=2024-12-31&solo_con_stock=true&proximos_dias=30",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8005",
              "path": [
                "api",
                "v1",
                "lotes"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Número de página"
                },
                {
                  "key": "page_size",
                  "value": "25",
                  "description": "Tamaño de página (máx 200)"
                },
                {
                  "key": "sort",
                  "value": "fechaVencimiento",
                  "description": "Campo de ordenamiento"
                },
                {
                  "key": "order",
                  "value": "asc",
                  "description": "Dirección: asc o desc"
                },
                {
                  "key": "producto_id",
                  "value": "some-product-id",
                  "description": "Filtro por ID de producto"
                },
                {
                  "key": "categoria_id",
                  "value": "some-category-id",
                  "description": "Filtro por ID de categoría"
                },
                {
                  "key": "bodega_id",
                  "value": "some-warehouse-id",
                  "description": "Filtro por ID de bodega"
                },
                {
                  "key": "fecha_desde",
                  "value": "2024-01-01",
                  "description": "Filtro por fecha de vencimiento desde (YYYY-MM-DD)"
                },
                {
                  "key": "fecha_hasta",
                  "value": "2024-12-31",
                  "description": "Filtro por fecha de vencimiento hasta (YYYY-MM-DD)"
                },
                {
                  "key": "solo_con_stock",
                  "value": "true",
                  "description": "Solo lotes con stock disponible"
                },
                {
                  "key": "proximos_dias",
                  "value": "30",
                  "description": "Filtro por lotes próximos a vencer (días)"
                }
              ]
            },
            "description": "Lista lotes con filtros avanzados. Endpoint público."
          }
        }
      ],
      "description": "Endpoints de gestión de lotes"
    },
    {
      "name": "Planes de Venta",
      "item": [
        {
          "name": "Crear Plan de Venta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer YOUR_JWT_TOKEN"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Plan Q1 2024\",\n  \"periodo\": {\n    \"desde\": \"2024-01-01\",\n    \"hasta\": \"2024-03-31\"\n  },\n  \"territorios\": [\n    \"territorio-id-1\",\n    \"territorio-id-2\"\n  ],\n  \"metas\": [\n    {\n      \"productoId\": \"producto-id-1\",\n      \"territorioId\": \"territorio-id-1\",\n      \"vendedorId\": 123,\n      \"objetivo_cantidad\": 1000,\n      \"objetivo_valor\": 50000.00,\n      \"nota\": \"Meta para vendedor principal\"\n    },\n    {\n      \"productoId\": \"producto-id-2\",\n      \"territorioId\": \"territorio-id-1\",\n      \"vendedorId\": 123,\n      \"objetivo_cantidad\": 500,\n      \"objetivo_valor\": null,\n      \"nota\": \"Meta solo por cantidad\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "http://localhost:8005/api/planes-venta",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8005",
              "path": [
                "api",
                "planes-venta"
              ]
            },
            "description": "Crea un plan de venta con metas por producto, territorio y vendedor. Requiere rol Administrador de Ventas. Cada meta debe tener al menos un objetivo (cantidad o valor) > 0."
          }
        },
        {
          "name": "Listar Planes de Venta",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer YOUR_JWT_TOKEN"
              }
            ],
            "url": {
              "raw": "http://localhost:8005/api/planes-venta?q=Plan Q1&estado=activo&periodo_from=2024-01-01&periodo_to=2024-12-31&territorioId=some-territory-id&productoId=some-product-id&sort=updated_at&order=desc&page=1&page_size=25",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8005",
              "path": [
                "api",
                "planes-venta"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "Plan Q1",
                  "description": "Búsqueda por nombre (case-insensitive)"
                },
                {
                  "key": "estado",
                  "value": "activo",
                  "description": "Filtro por estado: activo, borrador, cerrado, archivado"
                },
                {
                  "key": "periodo_from",
                  "value": "2024-01-01",
                  "description": "Filtro por período - fecha inicio (YYYY-MM-DD)"
                },
                {
                  "key": "periodo_to",
                  "value": "2024-12-31",
                  "description": "Filtro por período - fecha fin (YYYY-MM-DD)"
                },
                {
                  "key": "territorioId",
                  "value": "some-territory-id",
                  "description": "Filtro por territorio incluido en el plan"
                },
                {
                  "key": "productoId",
                  "value": "some-product-id",
                  "description": "Filtro por producto incluido en metas"
                },
                {
                  "key": "sort",
                  "value": "updated_at",
                  "description": "Campo de ordenamiento: nombre, periodo_desde, updated_at"
                },
                {
                  "key": "order",
                  "value": "desc",
                  "description": "Dirección: asc o desc"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Número de página"
                },
                {
                  "key": "page_size",
                  "value": "25",
                  "description": "Tamaño de página (máx 50)"
                }
              ]
            },
            "description": "Lista los planes de venta con búsqueda, filtros y paginación. Requiere rol Administrador de Ventas."
          }
        },
        {
          "name": "Obtener Plan de Venta por ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer YOUR_JWT_TOKEN"
              }
            ],
            "url": {
              "raw": "http://localhost:8005/api/planes-venta/{{plan_id}}",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8005",
              "path": [
                "api",
                "planes-venta",
                "{{plan_id}}"
              ]
            },
            "description": "Obtiene el detalle completo de un plan de venta incluyendo territorios y metas. Requiere rol Administrador de Ventas."
          }
        },
        {
          "name": "Listar Territorios (Catálogo)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer YOUR_JWT_TOKEN"
              }
            ],
            "url": {
              "raw": "http://localhost:8005/api/planes-venta/territorios/catalogo?activo=true",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8005",
              "path": [
                "api",
                "planes-venta",
                "territorios",
                "catalogo"
              ],
              "query": [
                {
                  "key": "activo",
                  "value": "true",
                  "description": "Filtrar por estado activo"
                }
              ]
            },
            "description": "Lista el catálogo de territorios disponibles para asignar a planes. Requiere rol Administrador de Ventas."
          }
        }
      ],
      "description": "Endpoints de gestión de planes de venta"
    },
