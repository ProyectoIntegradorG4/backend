{
	"info": {
		"name": "Listar Rutas - Endpoints Nuevos",
		"description": "Requests para el endpoint de listar rutas de entrega",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Listar Rutas - Todas",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "usuario-id",
						"value": "1"
					},
					{
						"key": "rol-usuario",
						"value": "admin"
					},
					{
						"key": "nit-usuario",
						"value": "900123456"
					}
				],
				"url": {
					"raw": "{{pedidos_url}}/api/v1/logistica/rutas?limit=50",
					"host": ["{{pedidos_url}}"],
					"path": ["api", "v1", "logistica", "rutas"],
					"query": [
						{
							"key": "limit",
							"value": "50",
							"description": "Número máximo de resultados"
						}
					]
				},
				"description": "Listar todas las rutas de entrega sin filtros"
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Status 200', () => {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response tiene estructura correcta', () => {",
							"    const response = pm.response.json();",
							"    pm.expect(response).to.have.property('total');",
							"    pm.expect(response).to.have.property('rutas');",
							"    pm.expect(response).to.have.property('filtros_aplicados');",
							"    pm.expect(response.rutas).to.be.an('array');",
							"});",
							"",
							"pm.test('Cada ruta tiene campos requeridos', () => {",
							"    const response = pm.response.json();",
							"    if (response.rutas.length > 0) {",
							"        const ruta = response.rutas[0];",
							"        pm.expect(ruta).to.have.property('ruta_id');",
							"        pm.expect(ruta).to.have.property('vehiculo_id');",
							"        pm.expect(ruta).to.have.property('estado');",
							"        pm.expect(ruta).to.have.property('total_pedidos');",
							"        pm.expect(ruta).to.have.property('distancia_total_km');",
							"        pm.expect(ruta).to.have.property('duracion_total_minutos');",
							"        pm.expect(ruta).to.have.property('fecha_creacion');",
							"    }",
							"});"
						]
					}
				}
			]
		},
